#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd -P)"
LOG_DIR="$ROOT/artifacts/logs"
BUILD_CACHE="$ROOT/.pf-cache"
mkdir -p "$LOG_DIR" "$ROOT/benchmarks/results"
mkdir -p "$BUILD_CACHE/swift" "$BUILD_CACHE/clang" "$BUILD_CACHE/spm"

# Keep compiler and SwiftPM caches inside the repository workspace. This makes
# the harness work in restricted environments without changing global settings.
export SWIFT_MODULECACHE_PATH="$BUILD_CACHE/swift"
export CLANG_MODULE_CACHE_PATH="$BUILD_CACHE/clang"
export SWIFTPM_MODULECACHE_OVERRIDE="$BUILD_CACHE/spm"

command_name="${1:-help}"
command_args="${*:2}"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log_file="$LOG_DIR/pf-${command_name}-${timestamp}.log"

run_logged() {
  set +e
  (cd "$ROOT" && "$@") >"$log_file" 2>&1
  status=$?
  set -e
  if [ "$status" -ne 0 ]; then
    echo "FAIL  pf $command_name (log: $log_file)"
    tail -n 12 "$log_file"
    exit "$status"
  fi
}

camera_space_relevant_paths=(Package.swift pf)
while IFS= read -r path; do
  camera_space_relevant_paths+=("$path")
done < <(git -C "$ROOT" ls-files -- 'Sources/**' 'Tests/**')

camera_space_source_state() {
  if git diff --quiet HEAD -- "${camera_space_relevant_paths[@]}" && git diff --cached --quiet -- "${camera_space_relevant_paths[@]}"; then
    echo "clean relevant paths"
  else
    echo "dirty relevant paths"
  fi
}

case "$command_name" in
  setup)
    if [ "$command_args" != "mobilenetv2" ]; then
      echo "usage: ./pf setup mobilenetv2"
      exit 2
    fi
    run_logged scripts/setup_mobilenetv2.sh
    echo "PASS  pf setup mobilenetv2 (log: $log_file)"
    tail -n 8 "$log_file"
    ;;
  doctor)
    PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" run_logged swift run -c debug planefuse doctor
    cat "$log_file"
    ;;
  build)
    run_logged swift build -c debug
    echo "PASS  pf build (log: $log_file)"
    ;;
  test)
    if [ "$command_args" != "quick" ]; then
      echo "usage: ./pf test quick"
      exit 2
    fi
    run_logged swift test -c debug
    echo "PASS  pf test quick (log: $log_file)"
    ;;
  verify)
    if [ "$command_args" = "mobilenetv2" ]; then
      run_logged swift run -c debug planefuse verify mobilenetv2
    elif [ "$command_args" = "float16" ]; then
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" run_logged swift run -c debug planefuse verify float16
    elif [ "$command_args" = "lineage" ]; then
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" run_logged swift run -c debug planefuse verify lineage
    elif [ -z "$command_args" ]; then
      run_logged swift run -c debug planefuse verify
    else
      echo "usage: ./pf verify|verify mobilenetv2|verify lineage|verify float16"
      exit 2
    fi
    cat "$log_file"
    ;;
  inspect)
    if [ "$command_args" != "mobilenetv2" ] && [ "$command_args" != "fixture" ]; then
      echo "usage: ./pf inspect mobilenetv2|fixture"
      exit 2
    fi
    run_logged swift run -c debug planefuse inspect "$command_args"
    cat "$log_file"
    ;;
  compile)
    if [ "$command_args" != "mobilenetv2" ]; then
      echo "usage: ./pf compile mobilenetv2"
      exit 2
    fi
    run_logged swift run -c debug planefuse compile mobilenetv2
    cat "$log_file"
    ;;
  live)
    if [ "$command_args" != "--help" ] && [ "$command_args" != "--sample" ] && [ "$command_args" != "--camera" ] && [ "$command_args" != "--app" ] && [ "$command_args" != "--camera-bench" ]; then
      echo "usage: ./pf live --help|--sample|--camera|--app|--camera-bench"
      exit 2
    fi
    if [ "$command_args" = "--camera-bench" ]; then
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/r6-camera.json}"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse-live "$command_args"
    else
      run_logged swift run -c debug planefuse-live "$command_args"
    fi
    cat "$log_file"
    ;;
  bench)
    if [ "$command_args" = "camera" ]; then
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/r6-camera.json}"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse-live --camera-bench
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "camera-space" ]; then
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/r6.5-camera-space.json}"
      source_tree_state="$(camera_space_source_state)"
      if [ "$source_tree_state" != "clean relevant paths" ]; then
        echo "FAIL pf bench camera-space: benchmark-relevant tracked paths are dirty"
        exit 1
      fi
      checked_paths="$(IFS=,; echo "${camera_space_relevant_paths[*]}")"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_SOURCE_TREE_STATE="$source_tree_state" PF_SOURCE_TREE_CHECKED_PATHS="$checked_paths" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse-live --camera-space-bench
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "polyphase" ] || [ "$command_args" = "polyphase confirm" ]; then
      if [ "$command_args" = "polyphase confirm" ]; then
        benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/r5-polyphase-confirm.json}"
        polyphase_confirm=1
      else
        benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/r5-polyphase-quick.json}"
        polyphase_confirm=0
      fi
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" PF_POLYPHASE_CONFIRM="$polyphase_confirm" run_logged swift run -c release planefuse bench polyphase
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "quick" ]; then
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/quick.json}"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse bench quick
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "fair quick" ] || [ "$command_args" = "fair confirm" ]; then
      if [ "$command_args" = "fair quick" ]; then
        benchmark_label="quick"
      else
        benchmark_label="confirm"
      fi
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/fair-$benchmark_label.json}"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse bench fair "$benchmark_label"
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "mobilenetv2 pipeline-a" ]; then
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/r6.3-pipeline-a.json}"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse bench mobilenetv2 pipeline-a
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "mobilenetv2 shared" ] || [ "$command_args" = "mobilenetv2 shared confirm" ]; then
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/r6.2-mobilenetv2-direct-shared.json}"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse bench mobilenetv2 shared
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "mobilenetv2 shared-batch" ]; then
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/proof/r7-repaired-batches/batch-${PF_R7_BATCH_INDEX:-missing}.json}"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse bench mobilenetv2 shared-batch
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "mobilenetv2 r75-batch" ]; then
      benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/proof/r7.5-source-reuse-batches/batch-${PF_R75_BATCH_INDEX:-missing}.json}"
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse bench mobilenetv2 r75-batch
      cat "$log_file"
      exit 0
    fi
    if [ "$command_args" = "mobilenetv2 shared-final" ]; then
      exec "$ROOT/scripts/run_r7_repaired_shared_batches.sh"
    fi
    if [ "$command_args" = "mobilenetv2 quick" ] || [ "$command_args" = "mobilenetv2 confirm" ] || [ "$command_args" = "mobilenetv2 b2" ]; then
      benchmark_label="${command_args##* }"
      if [ "$benchmark_label" = "b2" ]; then
        benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/r1-mobilenetv2-b2.json}"
        cli_benchmark_label="b2"
      else
        benchmark_output="${PF_BENCHMARK_OUTPUT:-$ROOT/benchmarks/results/m5-mobilenetv2-$benchmark_label.json}"
        cli_benchmark_label="$benchmark_label"
      fi
      PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse bench mobilenetv2 "$cli_benchmark_label"
      cat "$log_file"
      exit 0
    fi
    echo "usage: ./pf bench camera|camera-space|quick|fair quick|fair confirm|mobilenetv2 quick|mobilenetv2 confirm|mobilenetv2 shared|mobilenetv2 shared-batch|mobilenetv2 shared-final|mobilenetv2 r75-batch|mobilenetv2 pipeline-a"
    exit 2
    ;;
  quality)
    if [ "$command_args" != "mobilenetv2 b2-c1-shared" ]; then
      echo "usage: ./pf quality mobilenetv2 b2-c1-shared"
      exit 2
    fi
    quality_output="${PF_QUALITY_EVIDENCE_OUTPUT:-$ROOT/proof/r7-b2-c1-shared-quality.json}"
    quality_relevant_paths=(Package.swift pf)
    while IFS= read -r path; do
      quality_relevant_paths+=("$path")
    done < <(git -C "$ROOT" ls-files -- 'Sources/**' 'Tests/**')
    if ! git -C "$ROOT" diff --quiet HEAD -- "${quality_relevant_paths[@]}" || ! git -C "$ROOT" diff --cached --quiet HEAD -- "${quality_relevant_paths[@]}"; then
      quality_source_tree_state="dirty"
    else
      quality_source_tree_state="clean"
    fi
    PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_SOURCE_TREE_STATE="$quality_source_tree_state" PF_QUALITY_EVIDENCE_OUTPUT="$quality_output" run_logged swift run -c release planefuse quality mobilenetv2 b2-c1-shared
    cat "$log_file"
    ;;
  profile)
    if [ "$command_args" != "mobilenetv2" ] && [ "$command_args" != "mobilenetv2 shared" ]; then
      echo "usage: ./pf profile mobilenetv2|mobilenetv2 shared"
      exit 2
    fi
    if [ "$command_args" = "mobilenetv2 shared" ]; then
      profile_output="${PF_PROFILE_OUTPUT:-$ROOT/proof/r7-final-shared-path-profile.json}"
      profile_args="mobilenetv2 shared"
    else
      profile_output="${PF_PROFILE_OUTPUT:-$ROOT/benchmarks/results/r1-mobilenetv2-components.json}"
      profile_args="mobilenetv2"
    fi
    PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_PROFILE_OUTPUT="$profile_output" run_logged swift run -c release planefuse profile $profile_args
    cat "$log_file"
    ;;
  bridge)
    if [ "$command_args" = "mobilenetv2" ]; then
      bridge_args="mobilenetv2"
      default_output="$ROOT/benchmarks/results/r2-mobilenetv2-shared-bridge.json"
    elif [ "$command_args" = "mobilenetv2 confirm" ]; then
      bridge_args="mobilenetv2 confirm"
      default_output="$ROOT/benchmarks/results/r2-mobilenetv2-shared-bridge-confirm.json"
    else
      echo "usage: ./pf bridge mobilenetv2|mobilenetv2 confirm"
      exit 2
    fi
    benchmark_output="${PF_BENCHMARK_OUTPUT:-$default_output}"
    PF_ARCHITECTURE="$(uname -m)" PF_SWIFT_VERSION="$(swift --version | head -n 1)" PF_XCODE_VERSION="$(xcodebuild -version | head -n 1)" PF_GIT_COMMIT="$(git rev-parse HEAD)" PF_BUILD_CONFIGURATION="release" PF_BENCHMARK_OUTPUT="$benchmark_output" run_logged swift run -c release planefuse bridge $bridge_args
    cat "$log_file"
    ;;
  release)
    if [ "$command_args" != "validate" ]; then
      echo "usage: ./pf release validate"
      exit 2
    fi
    run_logged scripts/release_validate.sh
    echo "PASS  pf release validate (log: $log_file)"
    tail -n 12 "$log_file"
    ;;
  *)
    echo "usage: ./pf <setup mobilenetv2|doctor|build|test quick|inspect|compile|verify|bench|quality|profile mobilenetv2|profile mobilenetv2 shared|release validate>"
    exit 2
    ;;
esac
